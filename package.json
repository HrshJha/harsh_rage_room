{
  "name": "harsh-rage-room",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api 'npm:dev:web' 'npm:dev:api'",
    "dev:web": "vite --config web/vite.config.ts --host 127.0.0.1",
    "dev:api": "tsx watch --env-file-if-exists=.env api/src/server.ts",
    "build": "npm run typecheck && npm run build:web && npm run build:api",
    "build:web": "vite build --config web/vite.config.ts && tsx scripts/prerender.tsx",
    "build:api": "tsup api/src/server.ts --format esm --target node22 --out-dir api/dist",
    "start": "node --env-file-if-exists=.env api/dist/server.js",
    "preview": "vite preview --config web/vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docs": "node scripts/extract-docs.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:perf": "node scripts/performance.mjs",
    "format": "prettier --write web/src api/src shared tests e2e *.json *.ts *.js"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^2.1.3",
    "gsap": "^3.15.0",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
